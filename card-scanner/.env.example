# ---------------------------------------------------------------------------
# Card Scanner - variabili d'ambiente
# Copia in `.env.local` e compila. NESSUN segreto va committato.
# ---------------------------------------------------------------------------

# --- Database (Azure Database for PostgreSQL in produzione) ---
# In locale puoi usare SQLite cambiando provider in prisma/schema.prisma:
#   DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/cardscanner?schema=public"

# --- NextAuth / Auth.js ---
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="changeme-genera-un-segreto"
NEXTAUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (SSO) ---
# Da App registration nel portale Azure
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Amministrazione ---
# Email (separate da virgola) che hanno ruolo admin: vedono tutti i record
# e sono le uniche a poter configurare/usare l'integrazione Salesforce.
ADMIN_EMAILS="alessio.bonizzato@easysnap.com"

# --- Claude (Anthropic) per OCR biglietto + analisi note ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Trascrizione audio (provider configurabile) ---
# Valori: "openai" | "azure" | "none"
TRANSCRIBE_PROVIDER="none"
# Per provider "openai" (Whisper)
OPENAI_API_KEY=""
# Per provider "azure" (Azure AI Speech)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# --- Salesforce (gestito SOLO dall'admin) ---
# OAuth2 username-password flow di una Connected App dedicata.
SALESFORCE_LOGIN_URL="https://login.salesforce.com"
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
SALESFORCE_SECURITY_TOKEN=""
