// Prisma schema - Card Scanner
//
// DEFAULT: SQLite, per girare in locale a zero configurazione.
// PRODUZIONE (Azure): cambia provider in "postgresql" e imposta
// DATABASE_URL sul tuo Azure Database for PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Stati possibili (stringa per compatibilita' SQLite/Postgres):
// DRAFT | SENT | DUPLICATE | FAILED
model Lead {
  id     String @id @default(cuid())
  status String @default("DRAFT")

  // Utente (sales) che ha acquisito il contatto
  ownerEmail String
  ownerName  String?

  // Campi contatto estratti / modificabili
  firstName String?
  lastName  String?
  fullName  String?
  company   String?
  title     String?
  email     String?
  phone     String?
  mobile    String?
  website   String?
  address   String?
  city      String?
  country   String?

  // Campi valorizzati dall'analisi AI (scheda lead)
  industry       String?
  leadSource     String? @default("Business Card")
  rating         String? // Hot / Warm / Cold
  estimatedValue String?
  nextStep       String?
  aiSummary      String?

  // Note grezze del sales
  textNotes       String?
  audioTranscript String?

  // OCR grezzo del biglietto
  rawOcr String?

  // Riferimento immagine biglietto (data URL o storage key)
  cardImageRef String?

  // Esito invio a Salesforce
  salesforceId   String?
  salesforceType String? // "Lead" | "Contact"
  importMessage  String?
  sentAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerEmail])
  @@index([status])
}
